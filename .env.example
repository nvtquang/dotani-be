# Copy this file to .env before running docker compose.
# Replace every change-me value before running.

MYSQL_PORT=3306
MYSQL_ROOT_PASSWORD=change-me-local-root-password

DB_USERNAME=root
DB_PASSWORD=change-me-local-db-password

AUTH_JWT_SECRET=change-me-at-least-32-characters-jwt-secret
AUTH_INTERNAL_SECRET=change-me-auth-internal-secret
AUDIT_INTERNAL_SECRET=change-me-audit-internal-secret
NOTIFICATION_INTERNAL_SECRET=change-me-notification-internal-secret
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com

DEV_WARD_SECRETARY_USERNAME=ward.secretary
DEV_WARD_SECRETARY_EMAIL=ward.secretary@hcmcyu.local
DEV_WARD_SECRETARY_PASSWORD=Demo@12345

API_GATEWAY_PORT=8080
FRONTEND_PORT=5173

FRONTEND_URL=http://localhost:5173
VITE_API_BASE_URL=http://localhost:8080
VITE_CHAT_WS_URL=ws://localhost:8080/ws/chat
VITE_GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
